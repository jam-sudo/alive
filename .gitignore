# --- ALIVE: never commit data, checkpoints, or large/derived artifacts ---
/data/
/artifacts/
*.h5ad
*.h5
*.loom
*.zarr/
*.npy
*.npz
*.pt
*.ckpt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
*.egg-info/
.eggs/
build/
dist/

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Local scratch reference (never commit; not part of the tracked repo) ---
claude_science/

# --- OS / editor ---
.DS_Store
.playwright-mcp/
.idea/
.vscode/
*.bak

# --- graphify knowledge-graph build output (regenerable; never commit) ---
graphify-out/

# --- 민감 로그 (F-10): 인증/계정 metadata 가 실수로 commit 되는 것을 막는다 ---
error.log
*.error.log

# --- 로컬 생성물 (F-11): 추적 artifact 계약에 없는 산출물 ---
/output/
/tmp/
